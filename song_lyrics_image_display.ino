const uint8_t* const scenes[] PROGMEM = {
  scene1, scene2, scene3, scene4, scene5, scene6,
  scene7, scene8, scene9, scene10, scene11, scene12
};

const uint8_t TOTAL_SCENES = 12;
uint8_t currentScene = 0;
unsigned long lastChange = 0;

void showScene(uint8_t n) {
  display.clearDisplay();
  display.drawBitmap(0, 0, (const uint8_t*)pgm_read_ptr(&scenes[n]),
                     SCREEN_WIDTH, SCREEN_HEIGHT, SSD1306_WHITE);
  display.display();
}

void setup() {
  Serial.begin(115200);

  // ESP32 default I2C pins
  Wire.begin(21, 22);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    Serial.println("SSD1306 not found. Check wiring/address.");
    while (true) delay(100);
  }

  display.clearDisplay();
  display.display();

  showScene(0);
  lastChange = millis();
}

void loop() {
  if (millis() - lastChange >= SCENE_TIME) {
    lastChange = millis();

    currentScene++;
    if (currentScene >= TOTAL_SCENES) {
      currentScene = 0;
    }

    showScene(currentScene);
  }
}